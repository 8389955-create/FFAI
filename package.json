{
  "name": "ffai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @ffai/database generate",
    "db:migrate": "pnpm --filter @ffai/database migrate",
    "db:seed": "pnpm --filter @ffai/database seed",
    "db:deploy": "pnpm --filter @ffai/database deploy",
    "db:restore:production": "node scripts/restore-postgres-snapshot.mjs",
    "db:studio": "pnpm --filter @ffai/database studio",
    "cf:build": "cross-env CLOUDFLARE_STATIC_EXPORT=1 NEXT_PUBLIC_API_URL=/api/v1 pnpm --filter @ffai/web build",
    "cf:types": "wrangler types",
    "cf:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "cf:dry-run": "pnpm run cf:types && pnpm run cf:typecheck && pnpm run cf:build && wrangler deploy --dry-run",
    "cf:deploy": "node scripts/check-cloudflare-deploy.mjs && pnpm run cf:types && pnpm run cf:typecheck && pnpm run cf:build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@types/node": "24.5.2",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "pg": "8.16.3",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "wrangler": "^4.131.1"
  }
}

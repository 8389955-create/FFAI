# Copy to .env at the repository root. Never commit real secrets.
DATABASE_URL="postgresql://ffai:ffai_dev_only@localhost:5433/ffai?schema=public"
# Local seed convenience only. A remote database requires an explicit strong value.
FFAI_SEED_ADMIN_PASSWORD="Admin123!"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Cloudflare 生产构建时通过 shell 设置公网 HTTPS API：
# $env:NEXT_PUBLIC_API_URL="https://api.example.com/api/v1"
INTEGRATION_ENCRYPTION_KEY="replace-with-an-independent-32-byte-random-secret"
INTEGRATION_WEBHOOK_ALLOWED_HOSTS="hooks.example.com"

# Redis is available for future queue scaling; S3/R2 is the attachment storage adapter.
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="ffai-dev"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

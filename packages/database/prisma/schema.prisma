  materialNameCn        String?                 @db.VarChar(150)
  materialNameEn        String?                 @db.VarChar(150)
  color                 String?                 @db.VarChar(100)
  lengthMm              Int?
  widthMm               Int?
  heightMm              Int?
  weightKg              Decimal?                @db.Decimal(10, 3)
  unit                  String                  @default("件") @db.VarChar(30)
  factoryPrice          Decimal?                @db.Decimal(14, 2)
  retailPrice           Decimal?                @db.Decimal(14, 2)

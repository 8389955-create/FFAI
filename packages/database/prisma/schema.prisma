  unit             String        @default("件") @db.VarChar(30)
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse        Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location         StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])
  sku              ProductSku?   @relation(fields: [skuId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([locationId, stockKey])
  @@index([organizationId, warehouseId])
  @@index([organizationId, productId, skuId])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  organizationId  String
  transactionNo   String                   @db.VarChar(70)
  type            InventoryTransactionType
  warehouseId     String
  locationId      String
  productId       String
  skuId           String?
  quantity        Decimal                  @db.Decimal(14, 3)
  beforeQuantity  Decimal                  @db.Decimal(14, 3)
  afterQuantity   Decimal                  @db.Decimal(14, 3)
  unit            String                   @default("件") @db.VarChar(30)
  referenceType   String?                  @db.VarChar(50)
  referenceId     String?                  @db.VarChar(100)
  referenceLineId String?                  @db.VarChar(100)
  batchNo         String?                  @db.VarChar(80)
  note            String?
  operatorId      String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse       Warehouse                @relation(fields: [warehouseId], references: [id])
  location        StockLocation            @relation(fields: [locationId], references: [id])
  product         Product                  @relation(fields: [productId], references: [id])
  sku             ProductSku?              @relation(fields: [skuId], references: [id])
  operator        User                     @relation("InventoryOperator", fields: [operatorId], references: [id])
  createdAt       DateTime                 @default(now())

  @@unique([organizationId, transactionNo])
  @@index([organizationId, productId, skuId, createdAt])
  @@index([organizationId, warehouseId, locationId, createdAt])
  @@index([organizationId, referenceType, referenceId])
}

model AccountReceivable {
  id             String            @id @default(cuid())
  organizationId String
  receivableNo   String            @db.VarChar(70)
  salesOrderId   String            @unique
  customerId     String
  status         SettlementStatus  @default(UNPAID)
  currency       String            @default("CNY") @db.VarChar(10)
  totalAmount    Decimal           @db.Decimal(14, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(14, 2)
  dueDate        DateTime?
  notes          String?
  createdById    String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder        @relation(fields: [salesOrderId], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])
  createdBy      User              @relation("ReceivableCreator", fields: [createdById], references: [id])
  receipts       CustomerReceipt[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, receivableNo])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, customerId])
}

model CustomerReceipt {
  id             String            @id @default(cuid())
  organizationId String
  receiptNo      String            @db.VarChar(70)
  receivableId   String
  amount         Decimal           @db.Decimal(14, 2)
  method         PaymentMethod     @default(BANK_TRANSFER)
  receivedAt     DateTime          @default(now())
  transactionRef String?           @db.VarChar(120)
  note           String?
  collectedById  String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivable     AccountReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  collectedBy    User              @relation("ReceiptCollector", fields: [collectedById], references: [id])
  createdAt      DateTime          @default(now())

  @@unique([organizationId, receiptNo])
  @@index([organizationId, receivedAt])
  @@index([receivableId, receivedAt])
}

model AccountPayable {
  id              String            @id @default(cuid())
  organizationId  String
  payableNo       String            @db.VarChar(70)
  purchaseOrderId String            @unique
  supplierId      String
  status          SettlementStatus  @default(UNPAID)
  currency        String            @default("CNY") @db.VarChar(10)
  totalAmount     Decimal           @db.Decimal(14, 2)
  paidAmount      Decimal           @default(0) @db.Decimal(14, 2)
  dueDate         DateTime?
  notes           String?
  createdById     String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  createdBy       User              @relation("PayableCreator", fields: [createdById], references: [id])
  payments        SupplierPayment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([organizationId, payableNo])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, supplierId])
}

model SupplierPayment {
  id             String         @id @default(cuid())
  organizationId String
  paymentNo      String         @db.VarChar(70)
  payableId      String
  amount         Decimal        @db.Decimal(14, 2)
  method         PaymentMethod  @default(BANK_TRANSFER)
  paidAt         DateTime       @default(now())
  transactionRef String?        @db.VarChar(120)
  note           String?
  paidById       String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payable        AccountPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)
  paidBy         User           @relation("SupplierPaymentOperator", fields: [paidById], references: [id])
  createdAt      DateTime       @default(now())

  @@unique([organizationId, paymentNo])
  @@index([organizationId, paidAt])
  @@index([payableId, paidAt])
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  expenseNo      String        @db.VarChar(70)
  category       String        @db.VarChar(80)
  description    String        @db.VarChar(300)
  amount         Decimal       @db.Decimal(14, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  status         ExpenseStatus @default(DRAFT)
  occurredAt     DateTime
  dueDate        DateTime?
  paidAt         DateTime?
  transactionRef String?       @db.VarChar(120)
  notes          String?
  applicantId    String
  approvedById   String?
  paidById       String?
  approvedAt     DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicant      User          @relation("ExpenseApplicant", fields: [applicantId], references: [id])
  approvedBy     User?         @relation("ExpenseApprover", fields: [approvedById], references: [id])
  paidBy         User?         @relation("ExpensePayer", fields: [paidById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, expenseNo])
  @@index([organizationId, status, occurredAt])
  @@index([organizationId, applicantId])
}

model PayrollRecord {
  id              String        @id @default(cuid())
  organizationId  String
  payrollNo       String        @db.VarChar(70)
  employeeId      String
  period          String        @db.VarChar(7)
  baseAmount      Decimal       @default(0) @db.Decimal(14, 2)
  bonusAmount     Decimal       @default(0) @db.Decimal(14, 2)
  deductionAmount Decimal       @default(0) @db.Decimal(14, 2)
  netAmount       Decimal       @db.Decimal(14, 2)
  status          PayrollStatus @default(DRAFT)
  paidAt          DateTime?
  transactionRef  String?       @db.VarChar(120)
  notes           String?
  createdById     String
  paidById        String?
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        User          @relation("PayrollEmployee", fields: [employeeId], references: [id])
  createdBy       User          @relation("PayrollCreator", fields: [createdById], references: [id])
  paidBy          User?         @relation("PayrollPayer", fields: [paidById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, payrollNo])
  @@unique([organizationId, employeeId, period])
  @@index([organizationId, status, period])
}

model Shipment {
  id                 String            @id @default(cuid())
  organizationId     String
  shipmentNo         String            @db.VarChar(70)
  salesOrderId       String
  status             ShipmentStatus    @default(DRAFT)
  carrier            String?           @db.VarChar(120)
  trackingNo         String?           @db.VarChar(120)
  vehicleNo          String?           @db.VarChar(50)
  driverName         String?           @db.VarChar(100)
  driverPhone        String?           @db.VarChar(30)
  deliveryAddress    String            @db.VarChar(500)
  contactName        String?           @db.VarChar(100)
  contactPhone       String?           @db.VarChar(30)
  scheduledAt        DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  signedBy           String?           @db.VarChar(100)
  proofAttachmentIds String[]          @default([])
  notes              String?
  assignedToId       String?
  createdById        String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder         SalesOrder        @relation(fields: [salesOrderId], references: [id])
  assignedTo         User?             @relation("ShipmentAssignee", fields: [assignedToId], references: [id])
  createdBy          User              @relation("ShipmentCreator", fields: [createdById], references: [id])
  items              ShipmentItem[]
  installation       InstallationTask?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([organizationId, shipmentNo])
  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, assignedToId, status])
}

model ShipmentItem {
  id                String         @id @default(cuid())
  shipmentId        String
  salesOrderItemId  String
  stockLocationId   String?
  quantity          Decimal        @db.Decimal(12, 3)
  deliveredQuantity Decimal        @default(0) @db.Decimal(12, 3)
  stockIssuedAt     DateTime?
  shipment          Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  salesOrderItem    SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  stockLocation     StockLocation? @relation(fields: [stockLocationId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([shipmentId, salesOrderItemId])
  @@index([salesOrderItemId])
  @@index([stockLocationId])
}

model InstallationTask {
  id                 String             @id @default(cuid())
  organizationId     String
  installationNo     String             @db.VarChar(70)
  salesOrderId       String
  shipmentId         String?            @unique
  status             InstallationStatus @default(PENDING)
  address            String             @db.VarChar(500)
  contactName        String?            @db.VarChar(100)
  contactPhone       String?            @db.VarChar(30)
  scheduledStartAt   DateTime?
  scheduledEndAt     DateTime?
  actualStartAt      DateTime?
  actualEndAt        DateTime?
  completionNote     String?
  proofAttachmentIds String[]           @default([])
  notes              String?
  assignedToId       String?
  createdById        String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder         SalesOrder         @relation(fields: [salesOrderId], references: [id])
  shipment           Shipment?          @relation(fields: [shipmentId], references: [id])
  assignedTo         User?              @relation("InstallationAssignee", fields: [assignedToId], references: [id])
  createdBy          User               @relation("InstallationCreator", fields: [createdById], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([organizationId, installationNo])
  @@index([organizationId, status, scheduledStartAt])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, assignedToId, status])
}

model AfterSalesTicket {
  id             String              @id @default(cuid())
  organizationId String
  ticketNo       String              @db.VarChar(70)
  salesOrderId   String
  customerId     String
  type           AfterSalesType
  status         AfterSalesStatus    @default(OPEN)
  priority       AfterSalesPriority  @default(NORMAL)
  title          String              @db.VarChar(180)
  description    String
  resolution     String?
  reportedAt     DateTime            @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  attachmentIds  String[]            @default([])
  assignedToId   String?
  createdById    String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder          @relation(fields: [salesOrderId], references: [id])
  customer       Customer            @relation(fields: [customerId], references: [id])
  assignedTo     User?               @relation("AfterSalesAssignee", fields: [assignedToId], references: [id])
  createdBy      User                @relation("AfterSalesCreator", fields: [createdById], references: [id])
  comments       AfterSalesComment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, ticketNo])
  @@index([organizationId, status, priority])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, customerId])
  @@index([organizationId, assignedToId, status])
}

model AfterSalesComment {
  id             String           @id @default(cuid())
  organizationId String
  ticketId       String
  content        String
  internal       Boolean          @default(false)
  createdById    String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         AfterSalesTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy      User             @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())

  @@index([organizationId, ticketId, createdAt])
}

model WorkTask {
  id             String           @id @default(cuid())
  organizationId String
  taskNo         String           @db.VarChar(70)
  title          String           @db.VarChar(180)
  description    String?
  status         WorkTaskStatus   @default(TODO)
  priority       WorkTaskPriority @default(NORMAL)
  dueAt          DateTime?
  reminderAt     DateTime?
  completedAt    DateTime?
  sourceType     String?          @db.VarChar(60)
  sourceId       String?          @db.VarChar(100)
  sourceNo       String?          @db.VarChar(100)
  tags           String[]         @default([])
  assigneeId     String
  createdById    String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee       User             @relation("WorkTaskAssignee", fields: [assigneeId], references: [id])
  createdBy      User             @relation("WorkTaskCreator", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, taskNo])
  @@index([organizationId, assigneeId, status, dueAt])
  @@index([organizationId, sourceType, sourceId])
}

model AlertEvent {
  id               String        @id @default(cuid())
  organizationId   String
  fingerprint      String        @db.VarChar(220)
  category         String        @db.VarChar(60)
  severity         AlertSeverity @default(WARNING)
  status           AlertStatus   @default(OPEN)
  title            String        @db.VarChar(180)
  description      String?
  sourceType       String?       @db.VarChar(60)
  sourceId         String?       @db.VarChar(100)
  sourceNo         String?       @db.VarChar(100)
  dueAt            DateTime?
  detectedAt       DateTime      @default(now())
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  acknowledgedById String?
  resolvedById     String?
  metadata         Json?
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acknowledgedBy   User?         @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id])
  resolvedBy       User?         @relation("AlertResolver", fields: [resolvedById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, severity, detectedAt])
  @@index([organizationId, category, sourceType])
}

model AnalyticsSnapshot {
  id             String               @id @default(cuid())
  organizationId String
  snapshotDate   DateTime             @db.Date
  granularity    AnalyticsGranularity @default(DAILY)
  metrics        Json
  generatedById  String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedBy    User                 @relation("AnalyticsSnapshotGenerator", fields: [generatedById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, snapshotDate, granularity])
  @@index([organizationId, granularity, snapshotDate])
}

model AiInsight {
  id             String        @id @default(cuid())
  organizationId String
  fingerprint    String        @db.VarChar(220)
  type           String        @db.VarChar(60)
  status         InsightStatus @default(ACTIVE)
  severity       AlertSeverity @default(INFO)
  title          String        @db.VarChar(180)
  summary        String
  recommendation String
  evidence       Json
  generatedAt    DateTime      @default(now())
  expiresAt      DateTime?
  generatedById  String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedBy    User?         @relation("AiInsightGenerator", fields: [generatedById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, severity, generatedAt])
  @@index([organizationId, type])
}

model IntegrationChannel {
  id              String                  @id @default(cuid())
  organizationId  String
  type            IntegrationChannelType
  name            String                  @db.VarChar(120)
  status          IntegrationStatus       @default(INACTIVE)
  config          Json?
  lastSyncedAt    DateTime?
  lastError       String?
  createdById     String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("IntegrationChannelCreator", fields: [createdById], references: [id])
  apiClients      ApiClient[]
  subscriptions   WebhookSubscription[]
  productListings ProductChannelListing[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([organizationId, type])
  @@index([organizationId, status])
}

model ProductChannelListing {
  id                String             @id @default(cuid())
  organizationId    String
  productId         String
  channelId         String
  status            ProductSyncStatus  @default(NOT_SYNCED)
  externalProductId String?            @db.VarChar(160)
  payload           Json?
  payloadChecksum   String?            @db.VarChar(64)
  requestedById     String?
  requestedAt       DateTime?
  lastSyncedAt      DateTime?
  lastError         String?
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel           IntegrationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  requestedBy       User?              @relation("ProductSyncRequester", fields: [requestedById], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([productId, channelId])
  @@index([organizationId, status, updatedAt])
  @@index([channelId, status])
}

model ApiClient {
  id             String              @id @default(cuid())
  organizationId String
  channelId      String?
  name           String              @db.VarChar(120)
  clientKey      String              @unique @db.VarChar(80)
  secretHash     String
  scopes         String[]            @default([])
  active         Boolean             @default(true)
  lastUsedAt     DateTime?
  createdById    String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        IntegrationChannel? @relation(fields: [channelId], references: [id])
  createdBy      User                @relation("ApiClientCreator", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, active])
  @@index([organizationId, channelId])
}

model WebhookSubscription {
  id                     String              @id @default(cuid())
  organizationId         String
  channelId              String?
  name                   String              @db.VarChar(120)
  url                    String              @db.VarChar(1000)
  eventTypes             String[]            @default([])
  signingSecretEncrypted String
  active                 Boolean             @default(true)
  createdById            String
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel                IntegrationChannel? @relation(fields: [channelId], references: [id])
  createdBy              User                @relation("WebhookSubscriptionCreator", fields: [createdById], references: [id])
  deliveries             WebhookDelivery[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([organizationId, active])
  @@index([organizationId, channelId])
}

model WebhookOutbox {
  id             String            @id @default(cuid())
  organizationId String
  eventId        String            @unique @db.VarChar(80)
  eventType      String            @db.VarChar(120)
  aggregateType  String            @db.VarChar(80)
  aggregateId    String            @db.VarChar(120)
  payload        Json
  createdById    String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("WebhookOutboxCreator", fields: [createdById], references: [id])
  deliveries     WebhookDelivery[]
  createdAt      DateTime          @default(now())

  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, aggregateType, aggregateId])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  outboxId       String
  subscriptionId String
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  deliveredAt    DateTime?
  responseStatus Int?
  lastError      String?
  outbox         WebhookOutbox         @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([outboxId, subscriptionId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt])
}

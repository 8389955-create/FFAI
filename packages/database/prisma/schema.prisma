generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
  PENDING
}

enum OrgUnitType {
  COMPANY
  DEPARTMENT
  TEAM
  STORE
  FACTORY
  WAREHOUSE
}

enum DataScopeType {
  ALL
  COMPANY
  DEPARTMENT
  DEPARTMENT_AND_CHILDREN
  SELF
  CUSTOM
}

enum MenuType {
  DIRECTORY
  MENU
  ACTION
}

enum AttachmentStatus {
  PENDING
  READY
  QUARANTINED
  DELETED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  APPROVE
  REJECT
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  DEALER
  DESIGNER
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFYING
  WON
  LOST
}

enum ActivityType {
  CALL
  MESSAGE
  VISIT
  MEETING
  NOTE
}

enum ProjectStatus {
  INQUIRY
  MEASURING
  DESIGNING
  QUOTING
  CUSTOMER_REVIEW
  CONFIRMED
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectMemberRole {
  MANAGER
  SALES
  DESIGNER
  COLLABORATOR
  VIEWER
}

enum DesignStatus {
  DRAFT
  INTERNAL_REVIEW
  CUSTOMER_REVIEW
  APPROVED
  REJECTED
}

enum ProductType {
  FINISHED_GOOD
  CUSTOM_PRODUCT
  COMPONENT
  MATERIAL
  SERVICE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductAssetType {
  MAIN_IMAGE
  GALLERY
  DETAIL
  CAD
  MODEL_3D
  SPECIFICATION
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PLANNING
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  INSTALLED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ProductionOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum WorkOrderStatus {
  PENDING
  READY
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum WorkReportType {
  START
  PROGRESS
  COMPLETE
  ISSUE
}

enum WarehouseType {
  RAW_MATERIAL
  WORK_IN_PROGRESS
  FINISHED_GOODS
  MIXED
}

enum InventoryTransactionType {
  PURCHASE_RECEIPT
  PRODUCTION_RECEIPT
  SALES_ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum SettlementStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  WECHAT
  ALIPAY
  CARD
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  REJECTED
  VOID
}

enum PayrollStatus {
  DRAFT
  CONFIRMED
  PAID
  VOID
}

enum ShipmentStatus {
  DRAFT
  READY
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum InstallationStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AfterSalesType {
  DAMAGE
  QUALITY
  INSTALLATION
  REPAIR
  RETURN
  EXCHANGE
  OTHER
}

enum AfterSalesStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  CANCELLED
}

enum AfterSalesPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AnalyticsGranularity {
  DAILY
  WEEKLY
  MONTHLY
}

enum InsightStatus {
  ACTIVE
  DISMISSED
  ARCHIVED
}

enum IntegrationChannelType {
  WEBSITE
  WECHAT_MINI_PROGRAM
  TAOBAO
  WECOM
  DESIGNER_PORTAL
  DEALER_PORTAL
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD
}

enum ProductSyncStatus {
  NOT_SYNCED
  BLOCKED
  QUEUED
  SYNCING
  SYNCED
  FAILED
}

model Organization {
  id                     String                  @id @default(cuid())
  code                   String                  @unique @db.VarChar(50)
  name                   String                  @db.VarChar(100)
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  units                  OrgUnit[]
  users                  User[]
  roles                  Role[]
  numberRules            BusinessNumberRule[]
  dictionaries           Dictionary[]
  attachments            Attachment[]
  auditLogs              AuditLog[]
  customers              Customer[]
  leads                  Lead[]
  crmActivities          CrmActivity[]
  projects               Project[]
  productCategories      ProductCategory[]
  products               Product[]
  productTemplates       ProductTemplate[]
  productChannelListings ProductChannelListing[]
  quotations             Quotation[]
  contracts              Contract[]
  salesOrders            SalesOrder[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  productionOrders       ProductionOrder[]
  workOrders             WorkOrder[]
  workReports            WorkReport[]
  warehouses             Warehouse[]
  inventoryBalances      InventoryBalance[]
  inventoryTransactions  InventoryTransaction[]
  receivables            AccountReceivable[]
  customerReceipts       CustomerReceipt[]
  payables               AccountPayable[]
  supplierPayments       SupplierPayment[]
  expenses               Expense[]
  payrollRecords         PayrollRecord[]
  shipments              Shipment[]
  installations          InstallationTask[]
  afterSalesTickets      AfterSalesTicket[]
  afterSalesComments     AfterSalesComment[]
  workTasks              WorkTask[]
  alerts                 AlertEvent[]
  analyticsSnapshots     AnalyticsSnapshot[]
  aiInsights             AiInsight[]
  integrationChannels    IntegrationChannel[]
  apiClients             ApiClient[]
  webhookSubscriptions   WebhookSubscription[]
  webhookOutbox          WebhookOutbox[]
}

model OrgUnit {
  id             String                 @id @default(cuid())
  organizationId String
  parentId       String?
  code           String                 @db.VarChar(50)
  name           String                 @db.VarChar(100)
  type           OrgUnitType
  path           String                 @db.VarChar(1000)
  sort           Int                    @default(0)
  active         Boolean                @default(true)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         OrgUnit?               @relation("OrgTree", fields: [parentId], references: [id])
  children       OrgUnit[]              @relation("OrgTree")
  memberships    UserOrgUnit[]
  customScopes   RoleDataScopeOrgUnit[]
  customers      Customer[]
  leads          Lead[]
  projects       Project[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, path])
}

model User {
  id                      String                    @id @default(cuid())
  organizationId          String
  username                String                    @db.VarChar(50)
  employeeNo              String?                   @db.VarChar(50)
  phone                   String?                   @db.VarChar(30)
  email                   String?                   @db.VarChar(255)
  displayName             String                    @db.VarChar(100)
  jobTitle                String?                   @db.VarChar(100)
  remark                  String?
  passwordHash            String
  mustChangePassword      Boolean                   @default(true)
  passwordChangedAt       DateTime?
  status                  UserStatus                @default(ACTIVE)
  tokenVersion            Int                       @default(0)
  lastLoginAt             DateTime?
  organization            Organization              @relation(fields: [organizationId], references: [id])
  roles                   UserRole[]
  orgUnits                UserOrgUnit[]
  refreshTokens           RefreshToken[]
  uploadedFiles           Attachment[]              @relation("UploadedBy")
  auditLogs               AuditLog[]                @relation("AuditActor")
  ownedCustomers          Customer[]                @relation("CustomerOwner")
  createdCustomers        Customer[]                @relation("CustomerCreator")
  ownedLeads              Lead[]                    @relation("LeadOwner")
  createdLeads            Lead[]                    @relation("LeadCreator")
  crmActivities           CrmActivity[]             @relation("ActivityCreator")
  ownedProjects           Project[]                 @relation("ProjectOwner")
  createdProjects         Project[]                 @relation("ProjectCreator")
  projectMemberships      ProjectMember[]
  createdDesignVersions   DesignVersion[]           @relation("DesignCreator")
  reviewedDesignVersions  DesignVersion[]           @relation("DesignReviewer")
  createdProducts         Product[]                 @relation("ProductCreator")
  updatedProducts         Product[]                 @relation("ProductUpdater")
  createdProductTemplates ProductTemplate[]         @relation("ProductTemplateCreator")
  requestedProductSyncs   ProductChannelListing[]   @relation("ProductSyncRequester")
  ownedQuotations         Quotation[]               @relation("QuotationOwner")
  createdQuotations       Quotation[]               @relation("QuotationCreator")
  approvedQuotations      Quotation[]               @relation("QuotationApprover")
  createdContracts        Contract[]                @relation("ContractCreator")
  ownedSalesOrders        SalesOrder[]              @relation("SalesOrderOwner")
  createdSalesOrders      SalesOrder[]              @relation("SalesOrderCreator")
  orderStatusChanges      SalesOrderStatusHistory[]
  createdSuppliers        Supplier[]                @relation("SupplierCreator")
  buyingPurchaseOrders    PurchaseOrder[]           @relation("PurchaseBuyer")
  createdPurchaseOrders   PurchaseOrder[]           @relation("PurchaseCreator")
  approvedPurchaseOrders  PurchaseOrder[]           @relation("PurchaseApprover")
  createdProductionOrders ProductionOrder[]         @relation("ProductionCreator")
  assignedWorkOrders      WorkOrder[]               @relation("WorkOrderAssignee")
  createdWorkOrders       WorkOrder[]               @relation("WorkOrderCreator")
  workReports             WorkReport[]              @relation("WorkReporter")
  createdWarehouses       Warehouse[]               @relation("WarehouseCreator")
  inventoryTransactions   InventoryTransaction[]    @relation("InventoryOperator")
  createdReceivables      AccountReceivable[]       @relation("ReceivableCreator")
  collectedReceipts       CustomerReceipt[]         @relation("ReceiptCollector")
  createdPayables         AccountPayable[]          @relation("PayableCreator")
  paidSupplierPayments    SupplierPayment[]         @relation("SupplierPaymentOperator")
  appliedExpenses         Expense[]                 @relation("ExpenseApplicant")
  approvedExpenses        Expense[]                 @relation("ExpenseApprover")
  paidExpenses            Expense[]                 @relation("ExpensePayer")
  employeePayrollRecords  PayrollRecord[]           @relation("PayrollEmployee")
  createdPayrollRecords   PayrollRecord[]           @relation("PayrollCreator")
  paidPayrollRecords      PayrollRecord[]           @relation("PayrollPayer")
  assignedShipments       Shipment[]                @relation("ShipmentAssignee")
  createdShipments        Shipment[]                @relation("ShipmentCreator")
  assignedInstallations   InstallationTask[]        @relation("InstallationAssignee")
  createdInstallations    InstallationTask[]        @relation("InstallationCreator")
  assignedAfterSales      AfterSalesTicket[]        @relation("AfterSalesAssignee")
  createdAfterSales       AfterSalesTicket[]        @relation("AfterSalesCreator")
  afterSalesComments      AfterSalesComment[]
  assignedWorkTasks       WorkTask[]                @relation("WorkTaskAssignee")
  createdWorkTasks        WorkTask[]                @relation("WorkTaskCreator")
  acknowledgedAlerts      AlertEvent[]              @relation("AlertAcknowledger")
  resolvedAlerts          AlertEvent[]              @relation("AlertResolver")
  generatedSnapshots      AnalyticsSnapshot[]       @relation("AnalyticsSnapshotGenerator")
  generatedInsights       AiInsight[]               @relation("AiInsightGenerator")
  createdChannels         IntegrationChannel[]      @relation("IntegrationChannelCreator")
  createdApiClients       ApiClient[]               @relation("ApiClientCreator")
  createdWebhookSubs      WebhookSubscription[]     @relation("WebhookSubscriptionCreator")
  createdWebhookEvents    WebhookOutbox[]           @relation("WebhookOutboxCreator")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([organizationId, username])
  @@unique([organizationId, employeeNo])
  @@unique([organizationId, phone])
  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model UserOrgUnit {
  userId    String
  orgUnitId String
  isPrimary Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnit   OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([userId, orgUnitId])
}

model Role {
  id               String                 @id @default(cuid())
  organizationId   String
  code             String                 @db.VarChar(50)
  name             String                 @db.VarChar(100)
  description      String?
  isSystem         Boolean                @default(false)
  active           Boolean                @default(true)
  dataScope        DataScopeType          @default(SELF)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users            UserRole[]
  permissions      RolePermission[]
  menus            RoleMenu[]
  customScopeUnits RoleDataScopeOrgUnit[]
  fieldPermissions FieldPermission[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([organizationId, code])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(100)
  resource    String           @db.VarChar(80)
  action      String           @db.VarChar(40)
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@unique([resource, action])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Menu {
  id             String     @id @default(cuid())
  parentId       String?
  code           String     @unique @db.VarChar(80)
  name           String     @db.VarChar(100)
  type           MenuType
  path           String?
  icon           String?
  permissionCode String?
  sort           Int        @default(0)
  visible        Boolean    @default(true)
  parent         Menu?      @relation("MenuTree", fields: [parentId], references: [id])
  children       Menu[]     @relation("MenuTree")
  roles          RoleMenu[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model RoleMenu {
  roleId String
  menuId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
}

model RoleDataScopeOrgUnit {
  roleId    String
  orgUnitId String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  orgUnit   OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([roleId, orgUnitId])
}

model FieldPermission {
  id       String  @id @default(cuid())
  roleId   String
  resource String  @db.VarChar(80)
  field    String  @db.VarChar(80)
  canRead  Boolean @default(true)
  canWrite Boolean @default(false)
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, field])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model BusinessNumberRule {
  id             String       @id @default(cuid())
  organizationId String
  code           String       @db.VarChar(50)
  name           String       @db.VarChar(100)
  prefix         String       @db.VarChar(20)
  datePattern    String       @default("yyyyMMdd") @db.VarChar(20)
  sequenceLength Int          @default(4)
  currentDate    String?      @db.VarChar(20)
  currentValue   Int          @default(0)
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
}

model Dictionary {
  id             String           @id @default(cuid())
  organizationId String
  code           String           @db.VarChar(60)
  name           String           @db.VarChar(100)
  description    String?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          DictionaryItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, code])
}

model DictionaryItem {
  id           String     @id @default(cuid())
  dictionaryId String
  value        String     @db.VarChar(100)
  label        String     @db.VarChar(100)
  sort         Int        @default(0)
  active       Boolean    @default(true)
  metadata     Json?
  dictionary   Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, value])
}

model Attachment {
  id             String           @id @default(cuid())
  organizationId String
  uploadedById   String
  storageKey     String           @unique @db.VarChar(500)
  originalName   String           @db.VarChar(255)
  contentType    String           @db.VarChar(100)
  size           BigInt
  checksum       String?          @db.VarChar(128)
  status         AttachmentStatus @default(PENDING)
  businessType   String?          @db.VarChar(80)
  businessId     String?          @db.VarChar(100)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User             @relation("UploadedBy", fields: [uploadedById], references: [id])
  designVersions DesignVersion[]
  productAssets  ProductAsset[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, businessType, businessId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         AuditAction
  resource       String       @db.VarChar(80)
  resourceId     String?      @db.VarChar(100)
  requestId      String?      @db.VarChar(100)
  ip             String?      @db.VarChar(64)
  userAgent      String?
  before         Json?
  after          Json?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, resource, resourceId])
  @@index([organizationId, createdAt])
}

model Customer {
  id                String              @id @default(cuid())
  organizationId    String
  customerNo        String              @db.VarChar(50)
  type              CustomerType        @default(INDIVIDUAL)
  status            CustomerStatus      @default(PROSPECT)
  name              String              @db.VarChar(150)
  shortName         String?             @db.VarChar(100)
  phone             String?             @db.VarChar(30)
  email             String?             @db.VarChar(255)
  source            String?             @db.VarChar(80)
  level             String?             @db.VarChar(30)
  province          String?             @db.VarChar(50)
  city              String?             @db.VarChar(50)
  address           String?             @db.VarChar(500)
  tags              String[]            @default([])
  notes             String?
  ownerId           String
  orgUnitId         String
  createdById       String
  deletedAt         DateTime?
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User                @relation("CustomerOwner", fields: [ownerId], references: [id])
  orgUnit           OrgUnit             @relation(fields: [orgUnitId], references: [id])
  createdBy         User                @relation("CustomerCreator", fields: [createdById], references: [id])
  contacts          CustomerContact[]
  activities        CrmActivity[]
  convertedLeads    Lead[]              @relation("ConvertedCustomer")
  projects          Project[]
  quotations        Quotation[]
  contracts         Contract[]
  salesOrders       SalesOrder[]
  receivables       AccountReceivable[]
  afterSalesTickets AfterSalesTicket[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([organizationId, customerNo])
  @@index([organizationId, ownerId, status])
  @@index([organizationId, orgUnitId])
  @@index([organizationId, name])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String   @db.VarChar(100)
  title      String?  @db.VarChar(80)
  phone      String?  @db.VarChar(30)
  email      String?  @db.VarChar(255)
  wechat     String?  @db.VarChar(100)
  isPrimary  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, isPrimary])
}

model Lead {
  id                  String        @id @default(cuid())
  organizationId      String
  leadNo              String        @db.VarChar(50)
  name                String        @db.VarChar(150)
  contactName         String?       @db.VarChar(100)
  phone               String?       @db.VarChar(30)
  email               String?       @db.VarChar(255)
  source              String?       @db.VarChar(80)
  status              LeadStatus    @default(NEW)
  intentSummary       String?
  estimatedValue      Decimal?      @db.Decimal(14, 2)
  nextFollowUpAt      DateTime?
  lostReason          String?
  ownerId             String
  orgUnitId           String
  createdById         String
  convertedCustomerId String?
  deletedAt           DateTime?
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner               User          @relation("LeadOwner", fields: [ownerId], references: [id])
  orgUnit             OrgUnit       @relation(fields: [orgUnitId], references: [id])
  createdBy           User          @relation("LeadCreator", fields: [createdById], references: [id])
  convertedCustomer   Customer?     @relation("ConvertedCustomer", fields: [convertedCustomerId], references: [id])
  activities          CrmActivity[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([organizationId, leadNo])
  @@index([organizationId, ownerId, status])
  @@index([organizationId, orgUnitId])
  @@index([organizationId, nextFollowUpAt])
}

model CrmActivity {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String?
  leadId         String?
  type           ActivityType
  content        String
  occurredAt     DateTime     @default(now())
  nextFollowUpAt DateTime?
  createdById    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("ActivityCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, customerId, occurredAt])
  @@index([organizationId, leadId, occurredAt])
}

model Project {
  id                 String          @id @default(cuid())
  organizationId     String
  projectNo          String          @db.VarChar(50)
  customerId         String
  name               String          @db.VarChar(160)
  status             ProjectStatus   @default(INQUIRY)
  address            String?         @db.VarChar(500)
  estimatedBudget    Decimal?        @db.Decimal(14, 2)
  expectedDeliveryAt DateTime?
  ownerId            String
  orgUnitId          String
  createdById        String
  notes              String?
  tags               String[]        @default([])
  deletedAt          DateTime?
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer        @relation(fields: [customerId], references: [id])
